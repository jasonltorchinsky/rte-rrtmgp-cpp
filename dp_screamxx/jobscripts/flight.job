export HDF5_USE_FILE_LOCKING=FALSE
set -euo pipefail

# Run parameters - GATEIII
SCREAM_RUN_NAME=scream_dpxx_GATEIII_300x300_corrupt
SCREAM_START_TIME=1974-08-30-00000
RADTRAN_RUN_NAME=debug-1974-08-30
