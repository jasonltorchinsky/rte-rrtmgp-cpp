#-------------------------------------------------------------------------------
STAGE_NAME="RTE-RRTMGP-CPP+RT Combination"
echo "Beginning ${STAGE_NAME}..."

SEPARATE_DIR=${RTE_RRTMGP_CPP_RUN_DIR}/separate_input
COMBINED_DIR=${RTE_RRTMGP_CPP_RUN_DIR}/input

echo "SEPARATE_DIR: ${SEPARATE_DIR}"
echo "COMBINED_DIR: ${COMBINED_DIR}"
echo "DP_SCREAM FILE: ${DP_SCREAMXX_OUTPUT_FILE_PATH}"

srun --mpi=pmi2 -n ${SLURM_NTASKS} \
  python ${EXPERIMENT_DIR}/combine_rte_rrtmgp_cpp_files_new.py \
    --input-dir ${SEPARATE_DIR} \
    --output-dir ${COMBINED_DIR} \
    --dpscream-file ${DP_SCREAMXX_OUTPUT_FILE_PATH} \
    --kind in \
    --engine netcdf4 \
    --scheduler single-threaded \
    --replace-existing \
    --lock-writes \
    --keep-t-index \
    --time-chunk 1 \
    --xy-chunk 128

echo "${STAGE_NAME} complete!"
