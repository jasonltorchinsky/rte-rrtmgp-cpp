#!/bin/bash
#SBATCH --time=0-12:00:00
#SBATCH --nodes=42
#SBATCH --ntasks-per-node=1
#SBATCH --account=fy260144
#SBATCH --reservation=flight-cldera
#SBATCH --job-name=debug-2020-03-12
#SBATCH --output=%j.out
#SBATCH --error=%j.err

export HDF5_USE_FILE_LOCKING=FALSE

# Run parameters
SCREAM_RUN_NAME=scream_dpxx_COMBLE_400x400
RADTRAN_RUN_NAME=debug-2020-03-12

# Machine-specific DP-SCREAMXX directories - Abbereviated to SCREAM
SCREAM_DATA_DIR=/pscratch/jltorch/ml3drt/dpxx # DP-SCREAMXX output parent directory
SCREAM_RUN_DIR=${SCREAM_DATA_DIR}/${SCREAM_RUN_NAME}/run
SCREAM_OUTPUT_FILE_BASE=scream.INSTANT.nmins_x15.2020-03-12-79200
SCREAM_OUTPUT_FILE_PATH=${SCREAM_RUN_DIR}/${SCREAM_RUN_NAME}.${SCREAM_OUTPUT_FILE_BASE}.nc

# Machine-specific RTE-RRTMGP-CPP I/O directories - Abbreviated to RADTRAN
RADTRAN_DATA_DIR=/pscratch/jltorch/ml3drt/rte-rrtmgp-cpp
RADTRAN_RUN_DIR=${RADTRAN_DATA_DIR}/${SCREAM_RUN_NAME}/${RADTRAN_RUN_NAME}
RADTRAN_SEPARATE_INPUT_DIR=${RADTRAN_RUN_DIR}/separate_input
RADTRAN_COMBINED_INPUT_DIR=${RADTRAN_RUN_DIR}/combined_input
RADTRAN_SEPARATE_OUTPUT_DIR=${RADTRAN_RUN_DIR}/separate_output
RADTRAN_COMBINED_OUTPUT_DIR=${RADTRAN_RUN_DIR}/combined_output
RADTRAN_VIZ_DIR=${RADTRAN_RUN_DIR}/viz
RADTRAN_VIZ_INPUT_DIR=${RADTRAN_VIZ_DIR}/input
RADTRAN_FILE_BASE=${SCREAM_RUN_NAME}.${SCREAM_OUTPUT_FILE_BASE}
RADTRAN_INPUT_FILE_PATH_BASE=${RADTRAN_INPUT_DIR}/${RADTRAN_FILE_BASE}

mkdir -p ${RADTRAN_DATA_DIR}
mkdir -p ${RADTRAN_SEPARATE_INPUT_DIR}
mkdir -p ${RADTRAN_COMBINED_INPUT_DIR}
mkdir -p ${RADTRAN_SEPARATE_OUTPUT_DIR}
mkdir -p ${RADTRAN_COMBINED_OUTPUT_DIR}
mkdir -p ${RADTRAN_VIZ_DIR}

# RTE-RRTMGP-CPP directories
RTE_RRTMGP_CPP_DIR=/ascldap/users/jltorch/codes/rte-rrtmgp-cpp/jasonltorchinsky/dpscream-output-conversion # Source directory
SCREAM_DIR=${RTE_RRTMGP_CPP_DIR}/dp_screamxx # DP-SCREAMXX numerical experiment directory
EXPERIMENT_DIR=${SCREAM_DIR}/experiment
EXPERIMENT_ANALYZE_DIR=${EXPERIMENT_DIR}/analysis_tools

# Set Case - for Python Scripts
CASE_NAME="COMBLE"

#-------------------------------------------------------------------------------
# CHECK DIRECTORIES AND CASE FOR ERRORS
#-------------------------------------------------------------------------------
CURRENT_TIME=$(date +"%T")
echo "[${CURRENT_TIME}]: DEBUGGING - Directories used in script execution:"

echo "RADTRAN_SEPARATE_INPUT_DIR: ${RADTRAN_SEPARATE_INPUT_DIR}"
echo "RADTRAN_COMBINED_INPUT_DIR: ${RADTRAN_COMBINED_INPUT_DIR}"
echo "RADTRAN_SEPARATE_OUTPUT_DIR: ${RADTRAN_SEPARATE_OUTPUT_DIR}"
echo "RADTRAN_COMBINED_OUTPUT_DIR: ${RADTRAN_COMBINED_OUTPUT_DIR}"
echo "RADTRAN_VIZ_DIR: ${RADTRAN_VIZ_DIR}"
echo "CASE NAME: ${CASE_NAME}"
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
CURRENT_TIME=$(date +"%T")
STAGE_NAME="DP-SCREAM to RTE-RRTMGP-CPP+RT Conversion"
echo "[${CURRENT_TIME}]: Beginning ${STAGE_NAME}..."

# Set SZAs, times, and coarsening factors
COARSE_FACTORS=1,2,4,8,16,32,64

srun --mpi=pmi2 -n ${SLURM_NTASKS} \
  python ${EXPERIMENT_DIR}/convert-dpscream-output.py \
    --dp-scream-file ${SCREAM_OUTPUT_FILE_PATH} \
    --rad-tran-indir ${RADTRAN_SEPARATE_INPUT_DIR} \
    --coarse-factors ${COARSE_FACTORS} \
    --day-only

CURRENT_TIME=$(date +"%T")
echo "[${CURRENT_TIME}]: ${STAGE_NAME} complete!"
