#!/bin/bash
USE_RAY_TRACER=false  # Use ray-tracer
CUDA_DEVICE=0         # Which GPU to use

while [[ $# -gt 0 ]]; do
  case "$1" in
    --use-rt)
      USE_RAY_TRACER=true
      shift
      ;;
    --cuda-device)
      if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
        CUDA_DEVICE="$2"
        shift 2
      else
        echo "Error: --cuda-device requires an integer value."
        exit 1
      fi
      ;;
    *)
      echo "Error: Unknown argument: $1"
      echo "Usage: $0 [--use-rt] [--cuda-device INTEGER]"
      exit 1
      ;;
  esac
done

export CUDA_VISIBLE_DEVICES=${CUDA_DEVICE}

# RTE-RRTMGP-CPP directories
RTE_RRTMGP_CPP_DIR=$(realpath "..") # Source directory
RTE_RRTMGP_CPP_BUILD_DIR=${RTE_RRTMGP_CPP_DIR}/build
RTE_DATA_DIR=${RTE_RRTMGP_CPP_DIR}/data
RRTMGP_DATA_DIR=${RTE_RRTMGP_CPP_DIR}/rrtmgp-data

# Remove previous solver settings
rm *.txt

# Link RRTMGP files
ln -sf ${RRTMGP_DATA_DIR}/rrtmgp-clouds-sw.nc cloud_coefficients_sw.nc
ln -sf ${RRTMGP_DATA_DIR}/rrtmgp-clouds-lw.nc cloud_coefficients_lw.nc
ln -sf ${RRTMGP_DATA_DIR}/rrtmgp-gas-sw-g224.nc coefficients_sw.nc
ln -sf ${RRTMGP_DATA_DIR}/rrtmgp-gas-lw-g256.nc coefficients_lw.nc
ln -sf ${RTE_DATA_DIR}/aerosol_optics.nc

# Run RTE-RRTMGP-CPP
if [ "${USE_RAY_TRACER}" = true ]; then ## with ray tracer
  python test_rcemip_input_rt.py
# Flags:
# --shortwave          DEFAULT[true]  : Enable computation of shortwave radiation.
# --longwave           DEFAULT[false] : Enable computation of longwave radiation.
# --fluxes             DEFAULT[true]  : Enable computation of fluxes.
# --two-stream         DEFAULT[true]  : Run two-stream solver to obtain 1D fluxes.
# --raytracing         DEFAULT[32]    : Ray tracer rays-per pixel. '--raytracing False' to turn off.
# --independent-column DEFAULT[false] : Run ray tracer in independent column mode.
# --cloud-optics       DEFAULT[false] : Enable cloud optics (both liquid and ice).
# --liq-cloud-optics   DEFAULT[false] : Liquid only cloud optics.
# --ice-cloud-optics   DEFAULT[false] : Ice only cloud optics.
# --cloud-mie          DEFAULT[false] : Use Mie tables for cloud scattering in ray tracer.
# --aerosol-optics     DEFAULT[false] : Enable aerosol optics.
# --single-gpt         DEFAULT[false] : Output optical properties and fluxes for a single g-point. '--single-gpt 100': output 100th g-point.
# --profiling          DEFAULT[false] : Perform additional profiling run.
# --delta-cloud        DEFAULT[false] : Delta-scaling of cloud optical properties.
# --delta-aerosol      DEFAULT[false] : Delta-scaling of aerosol optical properties.
# --tica               DEFAULT[false] : Attenuate path when doing an overhead 1D calculation of tilted input.
  ${RTE_RRTMGP_CPP_BUILD_DIR}/test_rte_rrtmgp_rt_gpu --raytracing 256
else ## without ray tracer
  python test_rcemip_input.py
# Flags:
# --shortwave          DEFAULT[true]  : Enable computation of shortwave radiation.
# --longwave           DEFAULT[true]  : Enable computation of longwave radiation.
# --fluxes             DEFAULT[true]  : Enable computation of fluxes.
# --cloud-optics       DEFAULT[false] : Enable cloud optics (both liquid and ice).
# --aerosol-optics     DEFAULT[false] : Enable aerosol optics.
# --output-optical     DEFAULT[false] : Enable output of optical properties.
# --output-bnd-fluxes  DEFAULT[false] : Enable output of band fluxes.
# --timings            DEFAULT[false] : Repeat computation 10x for run times.
# --delta-cloud        DEFAULT[true]  : Delta-scaling of cloud optical properties.
# --delta-aerosol      DEFAULT[false] : Delta-scaling of aerosol optical properties.
  ${RTE_RRTMGP_CPP_BUILD_DIR}/test_rte_rrtmgp_gpu
fi

python flux_viz.py